{
  "name": "npm-outdated-check",
  "version": "1.86.7",
  "description": "CI-friendly dependency version threshold checker with configurable version drift limits and meaningful exit codes",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.cjs"
    }
  },
  "bin": {
    "npm-outdated-check": "./dist/bin/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "pretest": "npm run build",
    "test": "node --test --test-concurrency=1 test/test.mjs test/coverage-gaps.test.mjs test/coverage-gaps-2.test.mjs test/coverage-gaps-3.test.mjs test/coverage-gaps-4.test.mjs",
    "test:watch": "node --test --watch --test-concurrency=1 test/test.mjs test/coverage-gaps.test.mjs test/coverage-gaps-2.test.mjs test/coverage-gaps-3.test.mjs test/coverage-gaps-4.test.mjs",
    "lint": "eslint 'src/**/*.ts'",
    "format": "prettier --write \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "npm",
    "outdated",
    "dependencies",
    "ci",
    "version",
    "threshold",
    "semver",
    "check",
    "dependency",
    "management"
  ],
  "author": "Sulthon",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "chalk": "^5.4.0",
    "cli-table3": "^0.6.3",
    "commander": "^15.0.0",
    "semver": "^7.6.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "@types/semver": "^7.7.1",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.0.0",
    "js-yaml": "^5.0.0",
    "prettier": "^3.2.5",
    "tsup": "^8.0.2",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.65.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sulthonzh/npm-outdated-check.git"
  },
  "bugs": {
    "url": "https://github.com/sulthonzh/npm-outdated-check/issues"
  },
  "homepage": "https://github.com/sulthonzh/npm-outdated-check#readme",
  "overrides": {
    "esbuild": "0.28.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
